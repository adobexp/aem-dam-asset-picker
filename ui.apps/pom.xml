<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.adobexp</groupId>
        <artifactId>aem-dam-asset-picker</artifactId>
        <version>2.1.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>aem-dam-asset-picker.ui.apps</artifactId>
    <packaging>content-package</packaging>
    <name>AEM DAM Asset Picker - UI apps</name>
    <description>Components, clientlibs and the embedded core bundle for the Asset Picker</description>

    <properties>
        <!-- SPA clientlib jar unpacks to a staging dir, then the category folder is copied in.
             Generated artefacts are gitignored — see .gitignore. -->
        <clientlib.unpack.dir>${basedir}/../clientlib-unpack</clientlib.unpack.dir>
        <clientlib.picker.dir>${basedir}/src/main/content/jcr_root/apps/asset-picker/clientlibs/asset-picker.spa</clientlib.picker.dir>
        <clientlib.demo.dir>${basedir}/src/main/content/jcr_root/apps/asset-picker/clientlibs/clientlib-demo</clientlib.demo.dir>
        <!-- The demo host markup, styles and script are shared with the local mock harness so the
             two hosts cannot drift apart. -->
        <host.harness.dir>${basedir}/../ui.frontend.picker/public/host</host.harness.dir>
    </properties>

    <build>
        <sourceDirectory>src/main/content/jcr_root</sourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <configuration>
                    <filesets>
                        <fileset>
                            <directory>${clientlib.unpack.dir}</directory>
                        </fileset>
                        <fileset>
                            <directory>${clientlib.picker.dir}</directory>
                        </fileset>
                        <fileset>
                            <!-- Only the copies; host.css next to it is checked in. -->
                            <directory>${clientlib.demo.dir}</directory>
                            <includes>
                                <include>css/demo.css</include>
                                <include>js/demo.js</include>
                            </includes>
                        </fileset>
                    </filesets>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>unpack-picker-clientlib</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.adobexp</groupId>
                                    <artifactId>aem-dam-asset-picker.ui.frontend.picker</artifactId>
                                    <version>${project.version}</version>
                                    <type>jar</type>
                                    <overWrite>true</overWrite>
                                    <outputDirectory>${clientlib.unpack.dir}</outputDirectory>
                                    <excludes>META-INF/**</excludes>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-demo-host-assets</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${clientlib.demo.dir}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${host.harness.dir}</directory>
                                    <filtering>false</filtering>
                                    <includes>
                                        <include>demo.css</include>
                                    </includes>
                                    <targetPath>css</targetPath>
                                </resource>
                                <resource>
                                    <directory>${host.harness.dir}</directory>
                                    <filtering>false</filtering>
                                    <includes>
                                        <include>demo.js</include>
                                    </includes>
                                    <targetPath>js</targetPath>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-picker-spa-clientlib</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${clientlib.picker.dir}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${clientlib.unpack.dir}/asset-picker.spa</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.sling</groupId>
                <artifactId>htl-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>validate-htl</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>validate</goal>
                        </goals>
                        <configuration>
                            <generateJavaClasses>true</generateJavaClasses>
                            <failOnWarnings>false</failOnWarnings>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.jackrabbit</groupId>
                <artifactId>filevault-package-maven-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <group>com.adobexp</group>
                    <name>aem-dam-asset-picker.ui.apps</name>
                    <!-- mixed: ships components and the OSGi bundle that backs them -->
                    <packageType>mixed</packageType>
                    <accessControlHandling>ignore</accessControlHandling>
                    <failOnUncoveredSourceFiles>false</failOnUncoveredSourceFiles>
                    <properties>
                        <cloudManagerTarget>none</cloudManagerTarget>
                        <noIntermediateSaves>true</noIntermediateSaves>
                    </properties>
                    <!-- The bundle rides along with the components that use it, so the two can
                         never be deployed at different versions. -->
                    <embeddeds>
                        <embedded>
                            <groupId>com.adobexp</groupId>
                            <artifactId>aem-dam-asset-picker.core</artifactId>
                            <target>/apps/asset-picker/install</target>
                        </embedded>
                    </embeddeds>
                    <repositoryStructurePackages>
                        <repositoryStructurePackage>
                            <groupId>com.adobexp</groupId>
                            <artifactId>aem-dam-asset-picker.ui.apps.structure</artifactId>
                        </repositoryStructurePackage>
                    </repositoryStructurePackages>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.day.jcr.vault</groupId>
                <artifactId>content-package-maven-plugin</artifactId>
                <configuration>
                    <targetURL>http://${aem.host}:${aem.port}/crx/packmgr/service.jsp</targetURL>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>com.adobexp</groupId>
            <artifactId>aem-dam-asset-picker.core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.adobexp</groupId>
            <artifactId>aem-dam-asset-picker.ui.frontend.picker</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.adobexp</groupId>
            <artifactId>aem-dam-asset-picker.ui.apps.structure</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
        </dependency>
        <dependency>
            <groupId>com.adobe.aem</groupId>
            <artifactId>aem-sdk-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.sling</groupId>
            <artifactId>org.apache.sling.scripting.sightly.runtime</artifactId>
            <version>1.2.4-1.4.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.sling</groupId>
            <artifactId>org.apache.sling.scripting.sightly.compiler.java</artifactId>
            <version>1.2.0-1.4.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.sling</groupId>
            <artifactId>org.apache.sling.scripting.sightly.compiler</artifactId>
            <version>1.2.2-1.4.0</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
