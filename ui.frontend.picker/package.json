{
  "name": "@adobexp/aem-dam-asset-picker",
  "version": "1.0.0",
  "description": "React SPA Asset Picker for AEM, a drop-in replacement for the OOTB AEM Asset Picker.",
  "private": true,
  "scripts": {
    "start": "node src/framework/index.js",
    "start:mock": "cross-env API=mock node src/framework/index.js",
    "start:local": "cross-env API=local node src/framework/index.js",
    "build": "node esbuild-build-lib.mjs",
    "build:prod": "node esbuild-build-lib.mjs && npm run clientlib",
    "clientlib": "clientlib ./clientlib.config.js --verbose && node scripts/write-clientlib-contentxml.mjs",
    "mocks:thumbs": "node scripts/generate-mock-thumbnails.mjs",
    "typecheck": "tsc --noEmit",
    "code:lint": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "code:lintCheck": "eslint \"src/**/*.{ts,tsx}\"",
    "code:format": "prettier --write --no-error-on-unmatched-pattern \"src/**/*.{ts,tsx,js,json,scss}\"",
    "code:formatCheck": "prettier --check --no-error-on-unmatched-pattern \"src/**/*.{ts,tsx,js,json,scss}\"",
    "css:lint": "stylelint \"src/**/*.scss\" --fix",
    "css:lintCheck": "stylelint \"src/**/*.scss\""
  },
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/icons-material": "^5.15.19",
    "@mui/material": "^5.15.19",
    "@mui/x-tree-view": "6.0.0-alpha.0",
    "@tanstack/react-table": "^8.11.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.10.1",
    "react-router-dom": "^6.15.0",
    "react-select": "^5.8.0",
    "react-spinners": "0.13.4",
    "react-virtualized-auto-sizer": "^1.0.20",
    "react-window": "^1.8.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-window": "^1.8.7",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "aem-clientlib-generator": "^1.8.0",
    "classnames": "^2.3.2",
    "cross-env": "^7.0.3",
    "esbuild": "^0.19.2",
    "esbuild-plugin-svgr": "^2.1.0",
    "esbuild-sass-plugin": "^2.10.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "express": "^4.19.2",
    "globals": "^15.14.0",
    "http-proxy-middleware": "^2.0.6",
    "postcss": "^8.4.29",
    "postcss-modules": "^6.0.0",
    "prettier": "^3.0.3",
    "sass": "^1.75.0",
    "stylelint": "^15.10.3",
    "stylelint-config-sass-guidelines": "^10.0.0",
    "stylelint-config-standard": "^34.0.0",
    "stylelint-prettier": "^4.0.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.19.1"
  }
}
