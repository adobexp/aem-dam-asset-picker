<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:template="/apps/asset-picker/templates/component"
        jcr:language="ro"
        jcr:primaryType="cq:PageContent"
        jcr:title="Asset Selector"
        sling:resourceType="asset-picker/components/page"
        bodyClass="asset-picker-selector-page"
        clientlibs="[asset-picker.selector]">
        <selector
            jcr:primaryType="nt:unstructured"
            sling:resourceType="asset-picker/components/selector"
            rootPath="[/content/dam]"
            rootLabel="DAM"
            selectionMode="multiple"
            viewMode="browse"
            theme="light"
            targetOrigin="*"
            searchPageSize="{Long}100"
            showSearch="{Boolean}true"
            showFuzzySearch="{Boolean}true"
            showSemanticSearch="{Boolean}true"
            collapsibleFilters="{Boolean}true"
            displayDirectoryNames="{Boolean}true"/>
    </jcr:content>
</jcr:root>
